# Payload CMS + Neon PostgreSQL

# Neon pooled connection string, e.g. postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require
DATABASE_URI=

# Any long random string. Used to sign admin session cookies.
PAYLOAD_SECRET=

# Shared secret the marketing site sends as `x-api-key` when POSTing leads.
LEAD_API_KEY=

# Optional: send a notification email for every new lead (Resend).
RESEND_API_KEY=
RESEND_FROM=Vour <onboarding@resend.dev>
LEAD_NOTIFICATION_EMAIL=

# Public base URL of this admin app (used for canonical URLs, media URLs).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public base URL of the marketing site (vour-studio). Used by the admin panel
# to build preview links, e.g. https://vour-studio.vercel.app. Falls back to
# REVALIDATE_URL when unset.
MARKETING_SITE_URL=

# Marketing site revalidate webhook (POST /api/revalidate on the site).
REVALIDATE_URL=
REVALIDATE_SECRET=

# Optional: Cloudflare R2 (S3-compatible) for media uploads on Vercel.
# Unset: uploads go to the local filesystem (works locally, lost on Vercel).
# Free tier: 10 GB storage, $0 egress.
R2_BUCKET=
# Upload-only endpoint. e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL that SERVES the files (public r2.dev subdomain or custom domain).
# Wajib menyertakan protokol (https://) agar next/image bisa mematch URL-nya.
# e.g. https://pub-<hash>.r2.dev or https://media.vour.studio
R2_PUBLIC_URL=

# Topic Bank & Carousel Backend
CAROUSEL_BACKEND_URL=http://localhost:3001
VOURDEV_SERVICE_KEY=

# Omniroute (LLM Gateway)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://api.omniroute.com/v1
OMNIROUTE_MODEL=claude-3-5-sonnet

